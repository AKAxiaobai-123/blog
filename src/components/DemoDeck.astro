---
import { demoCards } from '../data/demo';

const cards = demoCards;
const pad = (index: number) => String(index + 1).padStart(2, '0');
---

<section class="demo" data-deck aria-labelledby="demo-heading">
  <div class="demo-head">
    <div>
      <p class="eyebrow">第一章 · 今天的一层</p>
      <h2 id="demo-heading" class="demo-heading">把今天，叠成一张卡片</h2>
      <p class="demo-intro">鼠标在卡片上划过，光会跟着视线走；点击任意一层，就能翻开里面的内容。</p>
    </div>
  </div>

  <div class="deck-stage" data-deck-stage>
    <ul class="deck-list">
      {
        cards.map((card, index) => (
          <li
            class="deck-item"
            data-deck-item
            style={`--deck-order: ${index}; --deck-z: ${12 - index}; --deck-shift: ${index * 12}px; --deck-scale: ${1 - index * 0.025}`}
          >
            <details class="deck-card" name="demo-card">
              <summary class="demo-summary">
                <span class={`demo-accent demo-accent-${card.accent}`} aria-hidden="true"></span>
                <span class="demo-index">{pad(index)}</span>
                <h3 class="demo-title">{card.title}</h3>
                <p class="demo-description">{card.description}</p>
                <span class="demo-toggle">翻开这一层</span>
              </summary>
              <div class="demo-detail">
                <p>{card.detail}</p>
              </div>
            </details>
          </li>
        ))
      }
    </ul>
  </div>

  <p class="deck-hint">移动鼠标，让光跟着视线走。</p>
</section>

<script is:inline>
  (() => {
    const root = document.querySelector('[data-deck]');
    if (!root) return;

    const stage = root.querySelector('[data-deck-stage]');
    const items = Array.from(root.querySelectorAll('[data-deck-item]'));
    if (!(stage instanceof HTMLElement) || items.length === 0) return;
    if (!window.matchMedia('(hover: hover)').matches) return;

    document.documentElement.classList.add('js');

    let raf = 0;

    const setFocus = (clientX, clientY) => {
      const rect = stage.getBoundingClientRect();
      const x = Math.min(1, Math.max(0, (clientX - rect.left) / rect.width));
      const y = Math.min(1, Math.max(0, (clientY - rect.top) / rect.height));
      const index = Math.min(items.length - 1, Math.max(0, Math.floor(x * items.length)));
      stage.style.setProperty('--deck-x', `${x * 100}%`);
      stage.style.setProperty('--deck-y', `${y * 100}%`);
      items.forEach((item, i) => {
        item.classList.toggle('is-focused', i === index);
        item.classList.toggle('is-adjacent', Math.abs(i - index) === 1);
      });
    };

    const onMove = (event) => {
      if (raf) return;
      raf = window.requestAnimationFrame(() => {
        raf = 0;
        setFocus(event.clientX, event.clientY);
      });
    };

    const onLeave = () => {
      if (raf) window.cancelAnimationFrame(raf);
      raf = 0;
      items.forEach((item) => item.classList.remove('is-focused', 'is-adjacent'));
    };

    stage.addEventListener('mousemove', onMove);
    stage.addEventListener('mouseleave', onLeave);
  })();
</script>
