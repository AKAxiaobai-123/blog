---
import { demoCards } from '../data/demo';

const cards = demoCards;
const pad = (index: number) => String(index + 1).padStart(2, '0');
---

<section class="demo" data-deck aria-labelledby="demo-heading">
  <div class="demo-head">
    <div>
      <p class="eyebrow">第一章 · 今天的一层</p>
      <h2 id="demo-heading" class="demo-heading">把今天，叠成一张卡片</h2>
      <p class="demo-intro">用下面的缩略图切换卡片，翻开每一层里的内容。</p>
    </div>
  </div>

  <div class="deck-stage" data-deck-stage>
    <ul class="deck-list">
      {
        cards.map((card, index) => (
          <li
            class={index === 0 ? 'deck-item is-active' : 'deck-item'}
            data-deck-item
            data-index={index}
          >
            <article class="deck-card">
              <div
                class={`demo-visual demo-accent-${card.accent} demo-visual-${card.visual}`}
                role="img"
                aria-label={card.imageAlt}
              >
                <span class="demo-visual-badge">DEMO</span>
              </div>
              <div class="demo-copy">
                <span class="demo-index">{pad(index)}</span>
                <h3 class="demo-title">{card.title}</h3>
                <p class="demo-description">{card.description}</p>
                <details class="demo-details" name="demo-card">
                  <summary class="demo-toggle">展开详情</summary>
                  <p>{card.detail}</p>
                </details>
              </div>
            </article>
          </li>
        ))
      }
    </ul>
  </div>

  <ul class="deck-thumbs" data-deck-thumbs aria-label="切换演示卡片">
    {
      cards.map((card, index) => (
        <li>
          <button
            class={index === 0 ? 'deck-thumb is-active' : 'deck-thumb'}
            type="button"
            data-deck-thumb
            aria-pressed={index === 0 ? 'true' : 'false'}
            aria-label={`切换到：${card.title}`}
          >
            <span class={`thumb-visual demo-accent-${card.accent}`} aria-hidden="true"></span>
            <span class="thumb-label">{pad(index)}</span>
          </button>
        </li>
      ))
    }
  </ul>

  <p class="deck-hint">点击或悬停缩略图切换卡片。</p>
</section>

<script is:inline>
  (() => {
    const root = document.querySelector('[data-deck]');
    if (!root) return;

    const items = Array.from(root.querySelectorAll('[data-deck-item]'));
    const thumbs = Array.from(root.querySelectorAll('[data-deck-thumb]'));
    if (items.length === 0 || thumbs.length === 0) return;

    document.documentElement.classList.add('js');

    const render = (index) => {
      items.forEach((item, i) => {
        const back = (i - index + items.length) % items.length;
        item.classList.toggle('is-active', i === index);
        item.style.zIndex = i === index ? '30' : String(20 - back);
        item.style.opacity = i === index ? '1' : String(Math.max(0.42, 1 - back * 0.16));

        if (i === index) {
          item.style.transform = 'none';
          return;
        }

        const direction = i < index ? -1 : 1;
        item.style.transform =
          `perspective(1100px) rotateY(${direction * 3}deg) rotateX(2.5deg) ` +
          `translate(${back * 26}px, ${back * 16}px) ` +
          `scale(${Math.max(0.86, 1 - back * 0.05)})`;
      });

      thumbs.forEach((thumb, i) => {
        thumb.classList.toggle('is-active', i === index);
        thumb.setAttribute('aria-pressed', String(i === index));
      });
    };

    thumbs.forEach((thumb, i) => {
      thumb.addEventListener('click', () => render(i));
      if (window.matchMedia('(hover: hover)').matches) {
        thumb.addEventListener('mouseenter', () => render(i));
      }
    });

    render(0);
  })();
</script>
