---
import { musicTracks } from '../data/music';

const tracks = musicTracks;
const firstTrack = tracks[0];
---

<section
  class="music-player"
  data-music-player
  aria-label="音乐播放条"
>
  <div class="music-main">
    <span class={`music-cover music-cover-${firstTrack.coverTone}`} data-music-cover aria-hidden="true">♪</span>

    <div class="music-info">
      <span class="music-title" data-music-title>{firstTrack.title}</span>
      <span class="music-artist" data-music-artist>{firstTrack.artist}</span>
    </div>

    <div class="music-controls" role="group" aria-label="播放控制">
      <button class="music-btn" type="button" data-music-prev disabled aria-label="上一首">
        <svg viewBox="0 0 16 16" aria-hidden="true" fill="currentColor">
          <path d="M3.5 3.5v9" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
          <path d="M13 3.5 6.5 8l6.5 4.5z" />
        </svg>
      </button>
      <button class="music-btn music-btn-play" type="button" data-music-toggle disabled aria-label="播放">
        <svg class="icon-play" viewBox="0 0 16 16" aria-hidden="true" fill="currentColor">
          <path d="M4.5 2.75v10.5l8.25-5.25z" />
        </svg>
        <svg class="icon-pause" viewBox="0 0 16 16" aria-hidden="true" fill="currentColor">
          <rect x="3.5" y="2.75" width="3.25" height="10.5" rx="1" />
          <rect x="9.25" y="2.75" width="3.25" height="10.5" rx="1" />
        </svg>
      </button>
      <button class="music-btn" type="button" data-music-next disabled aria-label="下一首">
        <svg viewBox="0 0 16 16" aria-hidden="true" fill="currentColor">
          <path d="M12.5 3.5v9" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
          <path d="M3 3.5 9.5 8 3 12.5z" />
        </svg>
      </button>
    </div>
  </div>

  <div class="music-progress">
    <span class="music-lyric" data-music-lyric aria-live="polite">
      {firstTrack.lyrics?.[0]?.text ?? '暂无歌词'}
    </span>
    <div class="music-progress-row">
      <input
        class="music-range"
        type="range"
        min="0"
        max="0"
        step="0.1"
        value="0"
        data-music-range
        disabled
        aria-label="播放进度"
        aria-valuetext="0:00 / 0:00"
      />
      <span class="music-time" data-music-time>0:00 / 0:00</span>
    </div>
  </div>

  <audio data-music-audio src={firstTrack.src} preload="metadata"></audio>

  <noscript>
    <ul class="music-no-js">
      {
        tracks.map((track) => (
          <li>{track.title} · {track.artist}</li>
        ))
      }
    </ul>
  </noscript>
</section>

<script>
  import { musicTracks } from '../data/music';

  (() => {
    const root = document.querySelector<HTMLElement>('[data-music-player]');
    if (!root) return;

    const audio = root.querySelector<HTMLAudioElement>('[data-music-audio]');
    const cover = root.querySelector<HTMLElement>('[data-music-cover]');
    const titleEl = root.querySelector<HTMLElement>('[data-music-title]');
    const artistEl = root.querySelector<HTMLElement>('[data-music-artist]');
    const prevButton = root.querySelector<HTMLButtonElement>('[data-music-prev]');
    const nextButton = root.querySelector<HTMLButtonElement>('[data-music-next]');
    const toggleButton = root.querySelector<HTMLButtonElement>('[data-music-toggle]');
    const range = root.querySelector<HTMLInputElement>('[data-music-range]');
    const timeEl = root.querySelector<HTMLElement>('[data-music-time]');
    const lyricEl = root.querySelector<HTMLElement>('[data-music-lyric]');

    if (!audio || !cover || !titleEl || !artistEl || !prevButton || !nextButton || !toggleButton || !range || !timeEl || !lyricEl) {
      return;
    }

    const STORAGE_KEY = 'blog.music.state';
    const tracks = musicTracks;
    const coverTones = tracks.map((track) => `music-cover-${track.coverTone}`);
    let currentIndex = 0;
    let pendingTime: number | null = null;

    function formatTime(seconds: number): string {
      if (!Number.isFinite(seconds) || seconds < 0) return '0:00';
      const whole = Math.floor(seconds);
      const minutes = Math.floor(whole / 60);
      const rest = whole % 60;
      return `${minutes}:${String(rest).padStart(2, '0')}`;
    }

    function readState(): { index: number; time: number } {
      try {
        const raw = localStorage.getItem(STORAGE_KEY);
        if (!raw) return { index: 0, time: 0 };
        const parsed = JSON.parse(raw) as { index?: number; time?: number };
        return {
          index: Number.isInteger(parsed.index) ? (parsed.index as number) : 0,
          time: typeof parsed.time === 'number' && parsed.time > 0 ? parsed.time : 0,
        };
      } catch {
        return { index: 0, time: 0 };
      }
    }

    function saveState(): void {
      try {
        localStorage.setItem(
          STORAGE_KEY,
          JSON.stringify({ index: currentIndex, time: audio.currentTime || 0 }),
        );
      } catch {
        // localStorage 不可用时静默跳过，不影响播放。
      }
    }

    function updateLyric(current: number): void {
      const lines = tracks[currentIndex].lyrics ?? [];
      let text = '暂无歌词';
      for (const line of lines) {
        if (current >= line.time) {
          text = line.text;
        } else {
          break;
        }
      }
      lyricEl.textContent = text;
    }

    function renderTrack(index: number): void {
      const track = tracks[index];
      titleEl.textContent = track.title;
      artistEl.textContent = track.artist;
      cover.classList.remove(...coverTones);
      cover.classList.add(`music-cover-${track.coverTone}`);
      audio.src = track.src;
      range.value = '0';
      timeEl.textContent = '0:00 / 0:00';
      updateLyric(0);
      saveState();
    }

    function setPlaying(playing: boolean): void {
      root.classList.toggle('is-playing', playing);
      toggleButton.setAttribute('aria-label', playing ? '暂停' : '播放');
    }

    function play(): void {
      audio.play()
        .then(() => setPlaying(true))
        .catch(() => setPlaying(false));
    }

    function pause(): void {
      audio.pause();
      setPlaying(false);
      saveState();
    }

    function togglePlay(): void {
      if (audio.paused) {
        play();
      } else {
        pause();
      }
    }

    function loadTrack(index: number, autoplay: boolean): void {
      const nextIndex = (index + tracks.length) % tracks.length;
      if (nextIndex === currentIndex && autoplay) {
        audio.currentTime = 0;
        play();
        return;
      }
      currentIndex = nextIndex;
      renderTrack(currentIndex);
      if (autoplay) {
        play();
      } else {
        setPlaying(false);
      }
    }

    function updateProgress(): void {
      const duration = audio.duration;
      if (!Number.isFinite(duration) || duration <= 0) return;
      const current = Math.min(audio.currentTime, duration);
      const percent = (current / duration) * 100;
      range.max = String(Math.floor(duration));
      range.value = String(current);
      range.style.setProperty('--range-progress', `${percent}%`);
      const label = `${formatTime(current)} / ${formatTime(duration)}`;
      timeEl.textContent = label;
      range.setAttribute('aria-valuetext', label);
      updateLyric(current);
    }

    audio.addEventListener('loadedmetadata', () => {
      if (pendingTime !== null) {
        if (Number.isFinite(audio.duration) && pendingTime < audio.duration) {
          audio.currentTime = pendingTime;
        }
        pendingTime = null;
      }
      updateProgress();
    });

    audio.addEventListener('timeupdate', updateProgress);

    audio.addEventListener('error', () => {
      setPlaying(false);
      lyricEl.textContent = '音频待补充';
      timeEl.textContent = '0:00 / 0:00';
      range.value = '0';
      range.max = '0';
      range.style.setProperty('--range-progress', '0%');
    });

    audio.addEventListener('ended', () => {
      if (currentIndex < tracks.length - 1) {
        loadTrack(currentIndex + 1, true);
      } else {
        audio.currentTime = 0;
        setPlaying(false);
        saveState();
      }
    });

    prevButton.addEventListener('click', () => loadTrack(currentIndex - 1, true));
    nextButton.addEventListener('click', () => loadTrack(currentIndex + 1, true));
    toggleButton.addEventListener('click', togglePlay);

    range.addEventListener('input', () => {
      const value = Number(range.value);
      const max = Number(range.max);
      if (Number.isFinite(value) && max > 0) {
        audio.currentTime = value;
        range.style.setProperty('--range-progress', `${(value / max) * 100}%`);
        timeEl.textContent = `${formatTime(value)} / ${formatTime(audio.duration)}`;
        updateLyric(value);
      }
    });

    range.addEventListener('change', saveState);
    window.addEventListener('pagehide', saveState);

    const saved = readState();
    currentIndex = Math.min(Math.max(saved.index, 0), tracks.length - 1);
    pendingTime = saved.time;
    if (currentIndex !== 0) {
      renderTrack(currentIndex);
    }

    root.dataset.enabled = 'true';
    prevButton.disabled = false;
    nextButton.disabled = false;
    toggleButton.disabled = false;
    range.disabled = false;
  })();
</script>
