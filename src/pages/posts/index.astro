---
import BaseLayout from '../../layouts/BaseLayout.astro';
import LeftPanel from '../../components/LeftPanel.astro';
import PostCard from '../../components/PostCard.astro';
import SidePanel from '../../components/SidePanel.astro';
import { getAllPosts } from '../../lib/posts';

const posts = await getAllPosts();
---

<BaseLayout title="文章 · Blog" description="博客的全部文章列表。">
  <section class="page-hero container">
    <h1>文章</h1>
    <p>所有已发布的内容，按时间从新到旧排列。</p>
  </section>

  <div class="container">
    <div class="content-grid">
      <LeftPanel />

      <section class="page-section content-main">
        {
          posts.length > 0 ? (
            <div class="post-grid">
              {
                posts.map((post) => (
                  <PostCard
                    slug={post.slug}
                    title={post.title}
                    description={post.description}
                    category={post.category}
                    date={post.date}
                    tags={post.tags}
                  />
                ))
              }
            </div>
          ) : (
            <div class="empty-state">
              <p>还没有文章。</p>
            </div>
          )
        }
      </section>
      <SidePanel />
    </div>
  </div>
</BaseLayout>
