---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="页面未找到 · Blog" description="没有找到你访问的页面。">
  <section class="page-hero container">
    <h1>页面未找到</h1>
    <p>你访问的内容不存在或已被移动。</p>
    <p style="margin-top: var(--space-5)">
      <a href="/" style="color: var(--color-accent)">返回首页</a>
    </p>
  </section>
</BaseLayout>
